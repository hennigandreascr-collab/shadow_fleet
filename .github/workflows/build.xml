<project>
    <target name="init">
        <tstamp/>
    </target>
    <target name="buildMod" depends="init">
        <zip 
            destfile="${dist}/shadow_fleet.${DSTAMP}${TSTAM}.zip"
            basedir="../..">
            <zipfileset dir="uniforms/" includes="*.uniforms" prefix="."/>
            <zipfileset dir="localized_text/" includes="*.localized_text" prefix="localized_text"/>
            <zipfileset dir="entities/" includes="*.*" prefix="entities"/>
            <zipfileset dir="." includes=".mod_meta_data" prefix="."/>
            <zipfileset dir="." includes=".png" prefix="."/>
        </zip>
    </target>
</project>
